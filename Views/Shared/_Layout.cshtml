<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]MVC_Portfolio</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: linear-gradient(135deg, #0f172a, #020617);
        color: #e2e8f0;
        font-family: 'Inter', sans-serif;
    }

    .section {
        padding: 100px 0;
    }

    .glass {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .btn-primary {
        background: linear-gradient(45deg, #3b82f6, #06b6d4);
        border: none;
    }

    h1, h2 {
        font-weight: 700;
    }
</style>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark px-5 py-3">
    <a class="navbar-brand fw-bold" href="/">Beloved.dev</a>

    <div class="ms-auto d-flex gap-3">
        <a class="nav-link d-inline text-light" href="/Home/About">About</a>
        <a class="nav-link d-inline text-light" href="/Home/Projects">Projects</a>
        <a class="nav-link d-inline text-light" href="/Home/Skills">Skills</a>
        <a class="nav-link d-inline text-light" href="/Home/Experience">Experience</a>
        <a class="nav-link d-inline text-light" href="/Home/Contact">Contact</a>
        <a class="nav-link" href="/Home/TaxCalculator">Tax Calculator</a>
        <a class="nav-link" asp-controller="Gallery"
       asp-action="Index">Gallery</a>
    </div>
</nav>


    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

<footer class="text-center p-3">
    <small>© 2026 Beloved Adetola | Built with ASP.NET MVC</small>
</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
<script>
    AOS.init();
</script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
